{
  "name": "quiet-episode-controller",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:fixture": "node scripts/run_python.mjs tests/browser/run_dom_fixture_tests.py && node scripts/run_python.mjs tests/browser/run_provider_fixture_tests.py",
    "test:browser": "node scripts/run_python.mjs tests/browser/run_browser_tests.py",
    "validate:package": "node scripts/run_python.mjs scripts/validate_extension_package.py",
    "check": "npm test && npm run test:fixture && node scripts/run_python.mjs scripts/static_check.py && npm run validate:package && node scripts/run_python.mjs scripts/project_gate.py",
    "build:release": "node scripts/run_python.mjs scripts/build_release.py"
  }
}
